rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /drivers/{document} {
      allow read, write: if true;
    }
    match /pickups/{document} {
      allow read, write: if true;
    }
    match /logs/{document} {
      allow read, write: if true;
    }
    match /alerts/{document} {
      allow read, write: if true;
    }
    match /master_pickups/{document} {
      allow read, write: if true;
    }
  }
}
